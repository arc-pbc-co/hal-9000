# HAL 9000 deployment environment template.
# Copy this file to deploy/.env for local Compose runs.

ANTHROPIC_API_KEY=

POSTGRES_DB=hal9000
POSTGRES_PASSWORD=hal9000-dev

MINIO_ROOT_USER=hal9000
MINIO_ROOT_PASSWORD=hal9000-dev-secret

HAL9000_STORAGE_BUCKET=hal9000-artifacts
HAL9000_STORAGE_PREFIX=production/
HAL9000_STORAGE_REGION=us-east-1

HAL9000_BOOTSTRAP_PROJECT_SLUG=firm-research
HAL9000_BOOTSTRAP_PROJECT_NAME=Firm Research
HAL9000_BOOTSTRAP_OWNER=research@example.com

HAL9000_WORKER_BATCH_SIZE=5
HAL9000_WORKER_ACTOR=hal-compose-worker
HAL9000_WORKER_MAX_ATTEMPTS=2
HAL9000_WORKER_PHASE_TIMEOUT_SECONDS=900
HAL9000_WORKER_POLL_SECONDS=30

HAL9000_GATEWAY_PORT=9000
HAL9000_DOCS_PORT=8000
HAL9000_POSTGRES_PORT=5432
HAL9000_OBJECT_STORE_PORT=9002
HAL9000_OBJECT_STORE_CONSOLE_PORT=9001
