# HAL 9000 deployment environment template.
# Copy this file to deploy/.env for local Compose runs.

ANTHROPIC_API_KEY=
OPENAI_API_KEY=
HF_TOKEN=
GITHUB_TOKEN=
SEMANTIC_SCHOLAR_API_KEY=
LOCAL_LLM_API_KEY=

POSTGRES_DB=hal9000
POSTGRES_PASSWORD=hal9000-dev

MINIO_ROOT_USER=hal9000
MINIO_ROOT_PASSWORD=hal9000-dev-secret

HAL9000_STORAGE_BUCKET=hal9000-artifacts
HAL9000_STORAGE_PREFIX=production/
HAL9000_STORAGE_REGION=us-east-1

HAL9000_BOOTSTRAP_PROJECT_SLUG=firm-research
HAL9000_BOOTSTRAP_PROJECT_NAME=Firm Research
HAL9000_BOOTSTRAP_OWNER=research@example.com

HAL9000_WORKER_BATCH_SIZE=5
HAL9000_WORKER_ACTOR=hal-compose-worker
HAL9000_WORKER_MAX_ATTEMPTS=2
HAL9000_WORKER_PHASE_TIMEOUT_SECONDS=900
HAL9000_WORKER_POLL_SECONDS=30

HAL9000_GATEWAY_PORT=9000
HAL9000_APP_GATEWAY_PORT=9101
HAL9000_DOCS_PORT=8000
HAL9000_POSTGRES_PORT=5432
HAL9000_OBJECT_STORE_PORT=9002
HAL9000_OBJECT_STORE_CONSOLE_PORT=9001

HAL9000_AUTH__ENABLED=false
HAL9000_AUTH__OIDC_ISSUER_URL=
HAL9000_AUTH__OIDC_AUDIENCE=
HAL9000_AUTH__ADMIN_GROUPS='["hal:admins"]'
HAL9000_AUTH__TEAM_GROUP_PREFIX=hal:

HAL9000_SLACK_SIGNING_SECRET=
HAL9000_SLACK_USER_MAP_JSON={}
HAL9000_GOOGLE_SHEETS_TOKEN=
HAL9000_APP_GATEWAY__SLACK_REQUIRED=false
HAL9000_APP_GATEWAY__SLACK_SIGNING_SECRET=
HAL9000_APP_GATEWAY__SHEETS_WRITEBACK_ENABLED=false
HAL9000_APP_GATEWAY__SHEETS_WRITEBACK_TOKEN=

HAL9000_RETENTION__ENABLED=false
HAL9000_RETENTION__RUN_EVENT_DAYS=365
HAL9000_RETENTION__TOOL_CALL_DAYS=365
HAL9000_RETENTION__NOTIFICATION_DAYS=180
HAL9000_RETENTION__AUDIT_EVENT_DAYS=730
HAL9000_RETENTION__GATEWAY_SESSION_DAYS=30
HAL9000_RETENTION__PDF_ARTIFACT_DAYS=2555
HAL9000_RETENTION__OUTPUT_ARTIFACT_DAYS=1095
