# HAL 9000 Environment Configuration
# Copy this file to .env and fill in your values

# Anthropic API Key (required for RLM processing)
# ANTHROPIC_API_KEY=your-api-key-here

# Alternative: Set via HAL9000 prefix
# HAL9000_ANTHROPIC_API_KEY=your-api-key-here

# Environment profile (local, staging, production)
# HAL9000_ENVIRONMENT=local
# HAL9000_PROFILE=local

# Database URL (optional, defaults to SQLite)
# HAL9000_DATABASE__URL=sqlite:///./hal9000.db
# Production/staging standard:
# HAL9000_DATABASE__URL=postgresql+psycopg://user:password@host:5432/hal9000

# Obsidian vault path (optional)
# HAL9000_OBSIDIAN__VAULT_PATH=~/ObsidianVault/HAL9000Research

# Object storage
# HAL9000_STORAGE__BACKEND=local
# HAL9000_STORAGE__ROOT_PATH=./.hal9000_objects
# HAL9000_STORAGE__BACKEND=s3
# HAL9000_STORAGE__BUCKET=hal9000-production-artifacts
# HAL9000_STORAGE__PREFIX=production/
# HAL9000_STORAGE__REGION=us-east-1
# HAL9000_STORAGE__ENDPOINT_URL=https://s3-compatible.example.com

# Vector and embeddings
# HAL9000_VECTOR__BACKEND=pgvector
# HAL9000_VECTOR__EMBEDDING_PROVIDER=fake
# HAL9000_VECTOR__EMBEDDING_DIMENSION=1536
# HAL9000_VECTOR__RETRIEVAL_LIMIT=5

# ADAM Platform (when available)
# HAL9000_ADAM__API_URL=https://api.adam-platform.com
# HAL9000_ADAM__API_KEY=your-adam-api-key

# Processing settings
# HAL9000_PROCESSING__CHUNK_SIZE=50000
# HAL9000_PROCESSING__MAX_CONCURRENT_CALLS=5

# Logging
# HAL9000_LOG_LEVEL=INFO
# HAL9000_VERBOSE=false

# Google Drive (optional)
# HAL9000_CLOUD__GDRIVE__ENABLED=true
# HAL9000_CLOUD__GDRIVE__CREDENTIALS_PATH=./credentials.json
